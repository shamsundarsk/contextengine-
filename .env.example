# Context Engine Environment Configuration

# API Keys (optional depending on upstream models used)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM Support (Ollama / LM Studio OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Summarizer Model Config
SUMMARIZER_MODEL=claude-3-haiku-20240307

# SQLite Database Location
DB_PATH=./context.db

# Proxy Server Port
PROXY_PORT=4000

# Web Dashboard Port
WEB_PORT=3000
