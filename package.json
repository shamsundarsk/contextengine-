{
  "name": "context-engine-monorepo",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Versioned, transparent context-memory system for LLM agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "dev:core": "npm run dev -w packages/core",
    "dev:proxy": "npm run dev -w packages/proxy",
    "dev:mcp": "npm run dev -w packages/mcp-server",
    "dev:cli": "npm run dev -w packages/cli",
    "dev:web": "npm run dev -w packages/web",
    "dev": "concurrently \"npm run dev:proxy\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
